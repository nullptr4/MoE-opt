# Source this file after activate.sh only when collecting/using PyTorch
# Inductor AutoHeuristic data.  TileLang's MoE kernel does not call Inductor,
# so this is intentionally opt-in rather than enabled for every benchmark.
export TORCHINDUCTOR_AUTOHEURISTIC_COLLECT="${TORCHINDUCTOR_AUTOHEURISTIC_COLLECT:-pad_mm,mixed_mm}"
export TORCHINDUCTOR_AUTOHEURISTIC_USE="${TORCHINDUCTOR_AUTOHEURISTIC_USE:-pad_mm,mixed_mm}"
export TORCHINDUCTOR_AUTOHEURISTIC_LOG_PATH="${TORCHINDUCTOR_AUTOHEURISTIC_LOG_PATH:-$METAX_RACE_ROOT/logs/autoheuristic.jsonl}"

