# Keep profiler payloads out of normal Git history while retaining metadata
# and manifests in the repository.
data/profiler/**/raw/** filter=lfs diff=lfs merge=lfs -text
profiler/**/raw/** filter=lfs diff=lfs merge=lfs -text
*.mcprofiler filter=lfs diff=lfs merge=lfs -text
*.mcprof filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text

# Generated compiler evidence and replay patches are archived byte-for-byte.
data/profiler/**/stage1-generated-code/**/*.cu -whitespace
data/benchmarks/**/stage1-*-submission.patch -whitespace
